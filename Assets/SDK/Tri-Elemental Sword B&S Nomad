(Lightning ability)
private void LightningAbility(Creature creature, CollisionInstance collision)
{
    if (creature == null || creature.isKilled) return;

    // Apply electrocution visual + effect
    StatusData electrocute = Catalog.GetData<StatusData>("Electrocute", true);
    creature.TryPushStatusEffect(electrocute, 10f);

    // Force limp paralysis
    creature.ragdoll.SetState(Ragdoll.State.Inert);

    // Drop weapons
    creature.handLeft.TryRelease();
    creature.handRight.TryRelease();

    // Prevent AI recovery
    creature.brain.Stop();

    // Restore after 10 seconds
    creature.StartCoroutine(RestoreFromParalysis(creature, 10f));
}

(Fire ability)
private void FireAbility(Creature creature, CollisionInstance collision)
{
    if (creature == null || creature.isKilled) return;

    // 1. Small explosion knockback
    Explosion(
        collision.contactPoint,
        3f,     // radius
        6f      // force
    );

    // 2. Dismember hit limb
    if (collision.damageStruct.hitRagdollPart != null)
    {
        RagdollPart part = collision.damageStruct.hitRagdollPart;

        if (part.sliceAllowed && part.data.sliceForce > 0)
        {
            Vector3 sliceDir = collision.impactVelocity.normalized;

            creature.TrySlice(
                part,
                sliceDir,
                part.data.sliceForce * 2f
            );
        }
    }
}

(Gravity ability)
private void GravityAbility(Creature creature, CollisionInstance collision)
{
    if (creature == null || creature.isKilled) return;

    // 1. Knockback on hit
    Vector3 knockDir = collision.impactVelocity.normalized;
    creature.ragdoll.SetPhysicModifier(
        this,
        0.5f,
        0f,
        knockDir * 6f,
        ForceMode.Impulse
    );

    // 2. Apply gravity (float) effect
    StatusData gravityStatus = Catalog.GetData<StatusData>("Gravity", true);
    creature.TryPushStatusEffect(gravityStatus, 5f); // float duration

    // 3. Slam enemy downward after float ends
    creature.StartCoroutine(GravitySlam(creature, 5f));
}
