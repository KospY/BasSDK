using ThunderRoad;
using UnityEngine;
using System.Collections.Generic;

public class ItemModuleTriElementKatana : ItemModule
{
    public List<string> spellIds = new List<string>()
    {
        "Fire",
        "Lightning",
        "Gravity"
    };

    public float imbueEnergy = 50f;
    public float holdCancelTime = 0.4f;

    private int currentIndex = -1;
    private float altUseTimer;
    private bool altHeld;

    private Item item;

    public override void OnItemLoaded(Item item)
    {
        base.OnItemLoaded(item);
        this.item = item;

        item.OnHeldActionEvent += OnHeldAction;
    }

    private void OnHeldAction(RagdollHand hand, Handle handle, Interactable.Action action)
    {
        if (action == Interactable.Action.AlternateUseStart)
        {
            altHeld = true;
            altUseTimer = 0f;
        }

        if (action == Interactable.Action.AlternateUseStop)
        {
            if (altUseTimer < holdCancelTime)
            {
                CycleElement();
            }
            else
            {
                ClearImbue();
            }

            altHeld = false;
        }
    }

    public override void Update()
    {
        base.Update();

        if (altHeld)
            altUseTimer += Time.deltaTime;
    }

    private void CycleElement()
    {
        currentIndex++;

        if (currentIndex >= spellIds.Count)
            currentIndex = 0;

        ApplyImbue(spellIds[currentIndex]);
    }

    private void ApplyImbue(string spellId)
    {
        SpellCastCharge spell = Catalog.GetData<SpellCastCharge>(spellId, true);
        if (spell == null) return;

        foreach (Imbue imbue in item.imbues)
        {
            imbue.Transfer(spell, imbueEnergy);
        }

        item.data.PlayAudioClip("Imbue");
    }

    private void ClearImbue()
    {
        currentIndex = -1;

        foreach (Imbue imbue in item.imbues)
        {
            imbue.Clear();
        }

        item.data.PlayAudioClip("Disimbue");
    }
}

